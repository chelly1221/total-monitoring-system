{
  "name": "tms-ping-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-runtime.mjs && vite build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
