{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "네트워크 ping 감시",
  "mainBinaryName": "tms-ping-monitor",
  "version": "1.0.1",
  "identifier": "kr.chelly.tms-ping-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "네트워크 ping 감시", "width": 1440, "height": 900, "minWidth": 1050, "minHeight": 680, "center": true, "decorations": false }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "windows": {
      "webviewInstallMode": { "type": "fixedRuntime", "path": "webview2" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
