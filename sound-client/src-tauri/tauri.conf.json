{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMS SoundSense",
  "mainBinaryName": "tms-soundsense",
  "version": "3.1.0",
  "identifier": "kr.chelly.tms-soundsense",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "통합알람감시 음성탐지기",
        "width": 460,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true,
        "url": "index.html",
        "decorations": false,
        "shadow": true
      },
      {
        "label": "mute",
        "title": "음소거 해제 시간 선택",
        "url": "mute.html",
        "width": 320,
        "height": 336,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "webview2"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
